# ---------------------------------------------------------------------------
# Embeddings (elige UN proveedor; los tres dan 1536 dims)
#
#   EMBEDDING_PROVIDER vacío -> autodetecta en este orden:
#       1) OpenAI  si hay OPENAI_API_KEY
#       2) Gemini  si hay GEMINI_API_KEY
#       3) Cohere  si hay COHERE_API_KEY
#
#   Todos devuelven 1536 dimensiones, así que la columna vector(1536) y el
#   índice HNSW sirven sin cambios al cambiar de proveedor.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=
EMBEDDING_DIMENSIONS=1536

# --- Opción A: OpenAI (de pago) --------------------------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Opción B: Google Gemini (gratis) --------------------------------------
# Requiere una cuenta de Google con un proyecto de Cloud activo.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Opción C: Cohere (trial gratis) ---------------------------------------
# https://dashboard.cohere.com/api-keys
# Trial: 1.000 llamadas/mes, 2.000 inputs/min, 96 textos por petición.
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com/v2
COHERE_EMBEDDING_MODEL=embed-v4.0

# ---------------------------------------------------------------------------
# Supabase / PostgreSQL
#   Usa la cadena "Session pooler" o la conexión directa (puerto 5432).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Alternativa por variables sueltas (si no usas DATABASE_URL)
# PGHOST=aws-0-TU_REGION.pooler.supabase.com
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres.TU_REF
# PGPASSWORD=TU_PASSWORD
# PGSSLMODE=require

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
RAG_DOCS_DIR=documentos
RAG_BATCH_SIZE=64
RAG_MAX_CHARS=1400
RAG_MIN_CHARS=40
LOG_LEVEL=INFO
