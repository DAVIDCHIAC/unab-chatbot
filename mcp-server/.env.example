# ---------------------------------------------------------------------------
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env al repositorio.
# ---------------------------------------------------------------------------

APP_NAME=UNAB Academic MCP
APP_ENV=production
LOG_LEVEL=INFO

# --- Supabase / PostgreSQL ------------------------------------------------
# Project Settings -> Database -> Connection string (Session pooler)
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.TU_PROJECT_REF
DB_PASSWORD=TU_PASSWORD
DB_SSLMODE=require
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=10

# --- Servidor MCP ---------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=9000
MCP_PATH=/mcp

# Token que debe enviar n8n en el header: Authorization: Bearer <token>
# Déjalo vacío para desactivar la autenticación (solo en local).
MCP_API_TOKEN=

# Protección DNS rebinding. Agrega el host público exacto de tu EC2.
# Formatos válidos: "1.2.3.4:9000", "midominio.duckdns.org",
#                   "midominio.duckdns.org:*"
MCP_DNS_PROTECTION=true
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,0.0.0.0:*,TU_IP_PUBLICA:9000,midominio.duckdns.org,midominio.duckdns.org:*
MCP_ALLOWED_ORIGINS=

# --- Embeddings (RAG) -----------------------------------------------------
# Proveedor: "openai" | "gemini" | "cohere" | vacío (autodetecta por clave).
# Gemini (Google AI Studio) y Cohere (trial) tienen cuota gratuita y ambos
# devuelven 1536 dims, así que sirven sin tocar la columna vector(1536).
EMBEDDING_PROVIDER=
EMBEDDING_DIM=1536
EMBEDDING_TIMEOUT=30

# Opción A — OpenAI (de pago)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Opción B — Google Gemini (gratis: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Opción C — Cohere (trial gratis: https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com/v2
COHERE_EMBEDDING_MODEL=embed-v4.0
