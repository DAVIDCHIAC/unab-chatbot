# Se versiona únicamente el APK release como evidencia del entregable;
# el resto de artefactos de compilación sigue ignorado.
!app/build/
app/build/*
!app/build/app/
app/build/app/*
!app/build/app/outputs/
app/build/app/outputs/*
!app/build/app/outputs/apk/
app/build/app/outputs/apk/*
!app/build/app/outputs/apk/release/
app/build/app/outputs/apk/release/*
!app/build/app/outputs/apk/release/app-release.apk
app/android/.gradle/
app/android/local.properties
app/android/key.properties
app/android/**/gradle-wrapper.jar
app/android/gradlew
app/android/gradlew.bat
app/android/**/GeneratedPluginRegistrant.java

