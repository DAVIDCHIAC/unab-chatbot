    {
      "id": "9ef16561-361b-476f-9a4a-495824de2257",
      "name": "Respuesta Vacía",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        80
      ],
      "parameters": {
        "jsCode": "\nconst ctx = $('Normalizar Entrada').first().json;\nreturn [{\n  json: {\n    ...ctx,\n    respuesta: '¿Qué fecha académica quieres consultar? Por ejemplo: matrícula, exámenes finales o inicio de clases.',\n    tipo: 'calendario'\n  }\n}];\n",
        "options": {}
      }
    },
    {
      "id": "285ae740-4e84-4beb-a4c9-017d91ccbbc7",
      "name": "Formatear Respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        -120
      ],
      "parameters": {
        "jsCode": "\nconst ctx = $('Normalizar Entrada').first().json;\nconst out = $input.first().json;\n\nlet respuesta = out.output ?? out.text ?? out.respuesta ?? '';\nif (Array.isArray(respuesta)) {\n  respuesta = respuesta.map((r) => r.text ?? r.content ?? '').join('\\n');\n}\nrespuesta = String(respuesta || '').trim();\nif (!respuesta) {\n  respuesta = 'No pude generar una respuesta en este momento. Intenta reformular tu pregunta.';\n}\n\nreturn [{\n  json: {\n    session_id: ctx.session_id,\n    canal: ctx.canal,\n    id_estudiante: ctx.id_estudiante,\n    pregunta: ctx.pregunta,\n    respuesta,\n    tipo: 'calendario',\n    fuentes: [],\n    latencia_ms: Math.max(0, Date.now() - ctx.inicio_ms)\n  }\n}];\n",
        "options": {}
      }
    },
