    {
      "id": "b37bd844-8805-4ff8-b689-b8a01bf5e89c",
      "name": "Normalizar Filtro Calendario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\nconst body = input.body ?? input;\n// Normaliza a minúsculas y elimina diacriticos para que \"examen\" encuentre \"Examenes\".\nconst norm = (valor) => valor\n  ? String(valor).trim().toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n  : null;\nreturn [{\n  json: {\n    texto: norm(body.texto),\n    categoria: norm(body.categoria)\n  }\n}];\n",
        "options": {}
      }
    },
    {
      "id": "38998f92-3b80-4562-a1ae-40af68143dd8",
      "name": "Consultar Calendario (SQL)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, periodo, evento, categoria, fecha_inicio, fecha_fin, descripcion, dias_faltantes\nFROM unab.v_calendario_proximo\nWHERE ($1::text IS NULL\n        OR translate(evento, 'ÁÉÍÓÚáéíóúÑñ', 'AEIOUaeiouNn') ILIKE '%' || $1 || '%'\n        OR translate(COALESCE(descripcion, ''), 'ÁÉÍÓÚáéíóúÑñ', 'AEIOUaeiouNn') ILIKE '%' || $1 || '%')\n  AND ($2::text IS NULL OR categoria = $2)\nORDER BY fecha_inicio\nLIMIT 60;",
        "options": {
          "queryReplacement": "={{ [$json.texto, $json.categoria] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "39iAaWBFxHtb71mo",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "f8691728-b639-454b-9e64-5c4dbfbf8689",
      "name": "Empaquetar Calendario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map((i) => i.json).filter((r) => r && r.id !== undefined && r.id !== null);\nreturn [{ json: { ok: true, total: rows.length, eventos: rows } }];\n",
        "options": {}
      }
    },
