      "parameters": {
        "jsCode": "\nconst ctx = $('Normalizar Entrada').first().json;\nreturn [{\n  json: {\n    ...ctx,\n    respuesta: 'Para consultar tu historial o avance necesito tu código UNAB (por ejemplo 10045234). Escríbelo en el campo de identificación de la app.',\n    tipo: 'academico'\n  }\n}];\n"
      },
      "id": "9267daeb-cf1d-4c32-a414-bb33ab143d72",
      "name": "Respuesta Sin Código",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst ctx = $('Normalizar Entrada').first().json;\nconst out = $input.first().json;\n\nlet respuesta = out.output ?? out.text ?? out.respuesta ?? '';\nif (Array.isArray(respuesta)) {\n  respuesta = respuesta.map((r) => r.text ?? r.content ?? '').join('\\n');\n}\nrespuesta = String(respuesta || '').trim();\nif (!respuesta) {\n  respuesta = 'No pude generar una respuesta en este momento. Intenta reformular tu pregunta.';\n}\n\nreturn [{\n  json: {\n    session_id: ctx.session_id,\n    canal: ctx.canal,\n    id_estudiante: ctx.id_estudiante,\n    pregunta: ctx.pregunta,\n    respuesta,\n    tipo: 'academico',\n    fuentes: [],\n    latencia_ms: Math.max(0, Date.now() - ctx.inicio_ms)\n  }\n}];\n"
      },
