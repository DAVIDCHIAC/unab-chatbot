    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT row_to_json(e) FROM (SELECT * FROM unab.v_estado_estudiante WHERE id_estudiante = $1) e) AS estado,\n  (SELECT row_to_json(a) FROM (SELECT * FROM unab.v_avance_plan WHERE id_estudiante = $1) a) AS avance,\n  (SELECT row_to_json(p) FROM (SELECT * FROM unab.v_proyeccion_semestres WHERE id_estudiante = $1) p) AS proyeccion,\n  (SELECT COALESCE(json_agg(x), '[]'::json)\n     FROM (SELECT * FROM unab.v_alertas_academicas WHERE id_estudiante = $1) x) AS alertas,\n  (SELECT COALESCE(json_agg(x), '[]'::json)\n     FROM (SELECT curso_bloqueado, nombre_curso, semestre_sugerido,\n                  codigo_prerequisito, nombre_prerequisito,\n                  estado_prerequisito, tipo_bloqueo, nota_prerequisito\n           FROM unab.v_prerrequisitos_pendientes\n           WHERE id_estudiante = $1\n           ORDER BY semestre_sugerido, curso_bloqueado) x) AS bloqueados,\n  (SELECT COALESCE(json_agg(x), '[]'::json)\n     FROM (SELECT codigo_curso, curso, creditos, semestre_sugerido, area,\n                  periodo, nota, estado, intento\n           FROM unab.v_historial_detalle\n           WHERE id_estudiante = $1\n           ORDER BY periodo DESC, codigo_curso\n           LIMIT 20) x) AS historial;",
        "options": {
          "queryReplacement": "={{ [$json.id_estudiante] }}"
        }
      },
      "id": "193fd14e-b132-4ab6-9203-0a97f83bedb2",
